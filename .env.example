# ============================================================
# Tarjimon Bot — muhit o'zgaruvchilari
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring:
#   cp .env.example .env
# ============================================================

# MAJBURIY: @BotFather dan olingan bot tokeni
BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithYourOwnToken

# IXTIYORIY: rasmdan matn o'qish uchun onlayn zaxira (https://ocr.space/ocrapi)
# Agar rapidocr-onnxruntime yoki pytesseract o'rnatilgan bo'lsa, shart emas.
OCR_SPACE_API_KEY=

# IXTIYORIY: JSON ma'lumotlar saqlanadigan papka (default: ./data)
DATA_DIR=

# IXTIYORIY: bitta foydalanuvchi uchun saqlanadigan tarix yozuvlari soni (default: 200)
MAX_HISTORY_PER_USER=200
